{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/om/2.0/schemas/EVIDENCE_RECORD.v2.schema.json",
  "title": "OM 2.0 Durable Evidence Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "subject",
    "outcome"
  ],
  "properties": {
    "schema": {
      "const": "om.evidence/v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "kind": {
      "enum": [
        "candidate_freeze",
        "candidate_qualification",
        "significant_failure",
        "connected_qualification",
        "acceptance",
        "release",
        "risk_acceptance",
        "mutation_execution",
        "document_approval",
        "solution_acceptance",
        "experiment_conclusion"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "revision"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "git_commit",
                "document_revision",
                "version",
                "digest",
                "other"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "artifact_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64,128}$"
            }
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "ACCEPTED",
        "REJECTED",
        "INCONCLUSIVE"
      ]
    },
    "classification": {
      "enum": [
        "PRODUCT",
        "HARNESS",
        "ENVIRONMENT",
        "AUTH",
        "INCONCLUSIVE"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "run_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment_class": {
          "enum": [
            "LOCAL",
            "DEVELOPMENT",
            "NON_PRODUCTION",
            "PRODUCTION"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "artifacts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "uri": {
            "type": "string",
            "maxLength": 1000
          },
          "digest": {
            "type": "string",
            "pattern": "^sha(256|512):[0-9a-fA-F]+$"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_digest"
      ],
      "properties": {
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "authorized_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "evidence_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 1000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "FAIL"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "classification"
        ]
      }
    }
  ]
}
