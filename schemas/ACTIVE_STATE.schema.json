{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/om/2.0/schemas/ACTIVE_STATE.schema.json",
  "title": "OM 2.0 Active State Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "trusted_baseline",
    "active_work",
    "blockers",
    "next_actions"
  ],
  "properties": {
    "schema": {
      "const": "om.active-state/v1"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "trusted_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "commit"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      }
    },
    "active_work": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "issue": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pull_request": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          ]
        }
      }
    },
    "phase": {
      "enum": [
        "development",
        "pre_candidate",
        "candidate",
        "qualification",
        "acceptance",
        "release",
        "blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "ref": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "conditional_reads": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "ref"
        ],
        "properties": {
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}