{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "om.actions-runtime-map/v1",
  "title": "OM GitHub Actions runtime map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verified_on", "source", "scope", "node24_min_major"],
  "properties": {
    "schema": { "const": "om.actions-runtime-map/v1" },
    "verified_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": { "type": "string", "minLength": 10, "maxLength": 500 },
    "scope": { "type": "string", "minLength": 10, "maxLength": 500 },
    "node24_min_major": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^actions/[A-Za-z0-9_.-]+$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 99 }
    }
  }
}
