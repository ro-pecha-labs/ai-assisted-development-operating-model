{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/om/2.0/schemas/PROJECT.schema.json",
  "title": "OM 2.0 Project Bootstrap Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "repository",
    "governance",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "om.project/v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "profile": {
          "enum": [
            "DEV",
            "SOLUTION",
            "DOCUMENT",
            "EXPERIMENT",
            "LIGHT"
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "canonical"
      ],
      "properties": {
        "platform": {
          "enum": [
            "github",
            "gitlab",
            "azure_devops",
            "git_other"
          ]
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_model"
      ],
      "properties": {
        "operating_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "ref",
            "commit"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40,64}$"
            }
          }
        },
        "project_rules": {
          "type": "string",
          "pattern": "^\\\\.project/.+"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active"
      ],
      "properties": {
        "active": {
          "const": ".project/ACTIVE_STATE.yaml"
        }
      }
    },
    "external_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest"
      ],
      "properties": {
        "manifest": {
          "const": ".project/EXTERNAL_SOURCES.yaml"
        }
      }
    }
  }
}