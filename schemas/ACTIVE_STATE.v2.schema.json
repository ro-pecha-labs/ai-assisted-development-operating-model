{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/om/2.0/schemas/ACTIVE_STATE.v2.schema.json",
  "title": "OM 2.0 Universal Active State Contract v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "objective", "trusted_baseline", "active_work", "blockers", "next_actions"],
  "properties": {
    "schema": {"const": "om.active-state/v2"},
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "trusted_baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 300},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "revision": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["git_commit", "document_revision", "version", "digest", "other"]},
            "value": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      }
    },
    "active_work": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "locator"],
        "properties": {
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "label": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "phase": {"type": "string", "minLength": 1, "maxLength": 80},
    "blockers": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "summary": {"type": "string", "minLength": 1, "maxLength": 300},
          "locator": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "next_actions": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "conditional_reads": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["when", "locator"],
        "properties": {
          "when": {"type": "string", "minLength": 1, "maxLength": 120},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
